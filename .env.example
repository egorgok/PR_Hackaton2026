# GigaChat is optional. Without these values, search uses lexical matching.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# PEM-файл корневого сертификата НУЦ Минцифры.
GIGACHAT_CA_BUNDLE_FILE=./certs/russian_trusted_root_ca_pem.crt

# Job history and browser session
JOBS_DB_FILE=./data/jobs.sqlite3
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_MAX_AGE_SECONDS=31536000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Search limits
MAX_CONCURRENT_SOURCES=8
MAX_CANDIDATES_PER_SOURCE=40
SOURCE_TIMEOUT_SECONDS=18
GIGACHAT_TIMEOUT_SECONDS=22

# Custom OpenAI-compatible API.
AI_API_KEY=
AI_MODEL=gpt-6.1-sol
AI_BASE_URL=https://darkapi.shop/v1
AI_TIMEOUT_SECONDS=22
